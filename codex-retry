#!/usr/bin/env expect

package require huddle::json
package require json
package require json::write
json::write indented 0

namespace eval retry {
    variable current {}
    variable timer ""
    variable delay 5000
    variable sequence 0
    variable prefix codex-retry
    variable usedIds {}
    variable internal {}
    variable finished {}
}

proc field {value args} {
    if {[catch {dict get $value {*}$args} result]} { return "" }
    return $result
}

# Huddle preserves JSON types; Tcllib's writer escapes keys and control characters.
proc json_dump {value} {
    switch -- [huddle type $value] {
        dict {
            set fields {}
            foreach key [huddle keys $value] {
                lappend fields $key [json_dump [huddle get $value $key]]
            }
            return [json::write object {*}$fields]
        }
        list {
            set items {}
            for {set i 0} {$i < [huddle llength $value]} {incr i} {
                lappend items [json_dump [huddle get $value $i]]
            }
            return [json::write array {*}$items]
        }
        string { return [json::write string [huddle get_stripped $value]] }
        null { return null }
        default { return [huddle get_stripped $value] }
    }
}

# Opt-in follow-ups have a separate lifetime from exit advice and overload replay.
namespace eval automatic {
    variable flags {auto_reset_limit 0 auto_continue_after_stop 0}
    variable configWarning ""
    variable current {}
    variable timer ""
    variable ids {}
    variable selection {}
    variable live {}
}

proc automatic::is {object type args} {
    expr {[huddle exists $object {*}$args] && [huddle type $object {*}$args] eq $type}
}
proc automatic::text {object args} {
    if {[is $object string {*}$args]} { return [huddle get_stripped $object {*}$args] }
    return ""
}
proc automatic::selected {object thread args} {
    variable selection
    set selection [dict create threadId $thread model [text $object {*}$args model] \
        provider [text $object {*}$args modelProvider]]
}

# Activation can attach to work already running in another client. An empty
# guard value means active work is confirmed but its turn ID is unavailable.
proc automatic::snapshot {result} {
    variable live; variable flags
    if {![dict get $flags auto_reset_limit] && ![dict get $flags auto_continue_after_stop]} { return }
    set thread [text $result thread id]
    if {$thread eq ""} { return }
    set active {}
    foreach path {{thread turns} {initialTurnsPage data}} {
        if {![is $result list {*}$path]} { continue }
        set turns [huddle get $result {*}$path]
        for {set i 0} {$i < [huddle llength $turns]} {incr i} {
            set turn [huddle get $turns $i]
            if {[text $turn status] eq "inProgress"} { dict set active [text $turn id] 1 }
        }
    }
    set status [text $result thread status type]
    if {[dict size $active] || $status eq "active"} {
        set id ""
        if {[dict size $active] == 1} { set id [lindex [dict keys $active] 0] }
        dict set live $thread $id
    } elseif {$status in {idle notLoaded systemError}} { dict unset live $thread }
}

proc automatic::read_only {method} {
    expr {$method in {thread/read thread/list thread/loaded/list thread/search thread/searchOccurrences
        thread/turns/list thread/items/list thread/items/read thread/timeline/list thread/goal/get
        thread/queue/list thread/backgroundTerminals/list thread/attachment/list
        thread/attachmentOwner/list thread/realtime/listVoices account/read account/rateLimits/read
        account/usage/read account/workspaceMessages/read account/gatewayOAuth/read}}
}

# Tcllib parses JSON. Counting its retained members against the string-free
# source rejects duplicate keys, which its dictionaries otherwise overwrite.
proc automatic::members {object} {
    set count 0
    switch -- [huddle type $object] {
        dict {
            foreach key [huddle keys $object] { incr count [expr {1 + [members [huddle get $object $key]]}] }
        }
        list {
            for {set i 0} {$i < [huddle llength $object]} {incr i} { incr count [members [huddle get $object $i]] }
        }
    }
    return $count
}
proc automatic::decode {json} {
    if {![json::validate $json]} { error "invalid JSON" }
    # Tcllib's lexical validator permits raw controls and extra whitespace.
    regsub -all {"(?:[^"\\\x00-\x1f]|\\(?:["\\/bfnrt]|u[0-9A-Fa-f]{4}))*"} $json 0 outside
    if {[regexp {["\\\x00-\x08\x0b\x0c\x0e-\x1f\x7f-\uffff]} $outside]} { error "invalid JSON characters" }
    # Wrapping forces the parser to consume the entire document, not a prefix.
    set wrapper [::huddle::json2huddle "\[$json\]"]
    if {[huddle llength $wrapper] != 1 || ![is $wrapper dict 0]} { error "expected one object" }
    set object [huddle get $wrapper 0]
    if {[regexp -all {:} $outside] != [members $object]} { error "duplicate JSON keys" }
    return $object
}

proc automatic::configure {} {
    variable flags; variable configWarning
    set flags {auto_reset_limit 0 auto_continue_after_stop 0}
    set configWarning ""
    if {[info exists ::env(XDG_CONFIG_HOME)] && [file pathtype $::env(XDG_CONFIG_HOME)] eq "absolute"} {
        set directory $::env(XDG_CONFIG_HOME)
    } elseif {[info exists ::env(HOME)]} {
        set directory [file join $::env(HOME) .config]
    } else {
        set configWarning "cannot locate codex-retry config.json; both automatic recovery flags are disabled"
        return
    }
    set path [file join $directory codex-retry config.json]
    if {[catch {file lstat $path stat} message options] && \
        [lrange [dict get $options -errorcode] 0 1] eq {POSIX ENOENT}} { return }
    if {[catch {
        set channel [open $path r]
        try {
            fconfigure $channel -encoding utf-8
            set json [read $channel 16385]
        } finally { close $channel }
        if {[string length $json] > 16384} { error "oversized JSON" }
        set object [decode $json]
        set configured $flags
        foreach key [dict keys $flags] {
            if {![huddle exists $object $key]} { continue }
            if {![is $object boolean $key]} { error "expected a JSON boolean" }
            dict set configured $key [expr {[huddle get_stripped $object $key] eq "true"}]
        }
        set flags $configured
    }]} {
        set configWarning "invalid or unreadable codex-retry config.json; both automatic recovery flags are disabled"
    }
}

proc automatic::notify {json} {
    if {![info exists ::client]} { return 0 }
    expr {![catch {websocket::send $::client text $json} result] && $result >= 0}
}
proc automatic::warn {message {thread ""}} {
    set target [huddle null]
    if {$thread ne ""} { set target [huddle string $thread] }
    set notice [huddle create method [huddle string warning] params [huddle create \
        threadId $target message [huddle string "codex-retry: $message"]]]
    if {![notify [json_dump $notice]]} { diagnostics::retain "codex-retry: $message\n" }
}
proc automatic::owns_retry {} {
    variable current
    expr {([field $current generated] eq "1" || [field $current phase] eq "continue_overload") && \
        [field $current rpcId] eq [field $::retry::current rpcId] && \
        [field $current threadId] eq [field $::retry::current threadId]}
}
proc automatic::cancel {} {
    variable current; variable timer
    # Invalidating an automatic continuation must also prevent its running or
    # backoff turn from re-arming through the overload engine.
    if {[owns_retry]} { retry::reset }
    after cancel $timer
    set timer ""
    set current {}
}
proc automatic::stop {message} {
    variable current
    warn "$message; work remains stopped" [field $current threadId]
    cancel
}

# The shared random prefix and monotonic sequence reserve IDs across both engines.
proc retry::next_id {} {
    variable prefix; variable sequence; variable usedIds
    while {1} {
        set id [huddle string "$prefix-[incr sequence]"]
        set key [json_dump $id]
        if {![dict exists $usedIds $key]} { break }
    }
    dict set usedIds $key 1
    return $id
}

proc automatic::client {object} {
    variable flags; variable current; variable configWarning; variable live
    set method [text $object method]
    if {$method eq "initialized" && $configWarning ne ""} {
        warn $configWarning
        set configWarning ""
    }
    if {$method eq "" || (![dict get $flags auto_reset_limit] && \
        ![dict get $flags auto_continue_after_stop])} { return }
    if {[read_only $method]} { return }
    set thread [text $object params threadId]
    if {$current ne "" && $thread ne "" && $thread ne [dict get $current threadId]} { cancel }
    if {[string match "account/*" $method]} { cancel }
    if {![string match "turn/*" $method] && ![string match "thread/*" $method] && \
        $method ni {review/start modelProvider/auth/set modelProvider/auth/clear}} { return }
    # All remaining thread/turn commands can mutate the task or its selection.
    set busy [expr {($current ne "" && [field $current phase] eq "running") || [dict exists $live $thread]}]
    set previous [field $current turnId]
    cancel
    if {$method ne "turn/start" || $busy || ![is $object dict params] || \
        $thread eq "" || ![huddle exists $object id] || \
        [huddle type $object id] ni {string number} || \
        ![is $object list params input] || [huddle llength [huddle get $object params input]] == 0} { return }
    set id [json_dump [huddle get $object id]]
    if {[dict exists $::retry::usedIds $id]} { return }
    set current [dict create request $object rpcId $id threadId $thread turnId "" \
        previous $previous early "" userId "" phase running accepted 0 generated 0 done 0]
}

# An overload replay belongs to the same manually initiated chain.
proc automatic::replay {request previous} {
    variable current
    if {$current eq "" || [field $current rpcId] ne $previous || \
        [field $current phase] ne "overload"} { return }
    dict set current request $request
    dict set current rpcId [json_dump [huddle get $request id]]
    dict set current previous [dict get $current turnId]
    foreach {key value} {turnId "" early "" userId "" phase running accepted 0 done 0} { dict set current $key $value }
    foreach key {terminal progress} { dict unset current $key }
}

proc automatic::user_item {item} {
    variable current
    # Stopped turns may repeat a verified echo, but cannot establish a new identity.
    if {[field $current phase] ne "running" && [field $current userId] eq ""} { cancel; return }
    set params [huddle get [dict get $current request] params]
    set id [text $item id]
    if {$id eq "" || ![is $item list content] || \
        ![huddle equal [retry::user_input [huddle get $params input]] \
            [retry::user_input [huddle get $item content]]]} { cancel; return }
    if {[huddle exists $params clientUserMessageId] && [huddle type $params clientUserMessageId] ne "null" && \
        (![is $params string clientUserMessageId] || \
         [text $item clientId] ne [text $params clientUserMessageId])} { cancel; return }
    if {[field $current userId] ne "" && [field $current userId] ne $id} { cancel; return }
    dict set current userId $id
}
proc automatic::items {turn} {
    variable current
    if {![is $turn list items]} { cancel; return }
    set items [huddle get $turn items]
    for {set i 0} {$i < [huddle llength $items] && $current ne ""} {incr i} {
        set item [huddle get $items $i]
        if {![is $item dict] || [text $item type] eq ""} { cancel; return }
        if {[text $item type] eq "userMessage"} { user_item $item }
        if {$current ne "" && [text $item type] ne "userMessage"} {
            # Repeated terminal snapshots may repeat known work, but must not
            # introduce progress after recovery has become eligible.
            if {[dict exists $current terminal]} {
                set known 0
                set previous [huddle get [dict get $current terminal] items]
                for {set j 0} {$j < [huddle llength $previous]} {incr j} {
                    if {[huddle equal $item [huddle get $previous $j]]} { set known 1; break }
                }
                if {!$known} { cancel; return }
            }
            dict set current progress 1
        }
    }
}

# Only an acknowledged terminal failure can queue an action. Zero-delay actions
# run after the native event has been forwarded, and are revalidated on dispatch.
proc automatic::queue {phase {delay 0}} {
    variable current; variable timer
    after cancel $timer
    dict set current phase $phase
    set timer [after $delay automatic::advance]
}

proc automatic::completed {turn} {
    variable current; variable flags; variable live
    if {[field $current done]} { return }
    dict set current terminal $turn
    dict set current done 1
    set thread [dict get $current threadId]
    if {[field $live $thread] eq [dict get $current turnId]} { dict unset live $thread }
    if {[text $turn status] ne "failed" || ![is $turn dict error] || ![is $turn string error message]} {
        cancel
        return
    }
    set code [text $turn error codexErrorInfo]
    if {$code eq "serverOverloaded"} {
        if {[dict get $flags auto_continue_after_stop] && [field $current progress] eq "1"} {
            queue continue_overload $::retry::delay
            set ::retry::delay [expr {min(1800000, $::retry::delay * 2)}]
        } else { dict set current phase overload }
        return
    }
    set phase ""
    if {$code eq "usageLimitExceeded" && [dict get $flags auto_reset_limit]} { set phase read_ready }
    if {$code eq "cyberPolicy" && [dict get $flags auto_continue_after_stop]} { set phase continue_stop }
    if {$phase eq ""} { cancel; return }
    queue $phase
}

proc automatic::server {object} {
    variable current; variable ids; variable flags; variable live
    set method [text $object method]
    set thread [text $object params threadId]
    set turn [text $object params turn id]
    if {$thread ne "" && $turn ne ""} {
        if {$method eq "turn/started" && [text $object params turn status] eq "inProgress" && \
            ![dict exists $::retry::finished [list $thread $turn]]} {
            dict set live $thread $turn
        } elseif {$method eq "turn/completed" && [field $live $thread] eq $turn && \
            [text $object params turn status] in {completed failed interrupted}} { dict unset live $thread }
    }
    if {$thread ne "" && $method in {thread/closed thread/archived thread/deleted}} { dict unset live $thread }
    if {$thread ne "" && $method eq "thread/status/changed"} {
        set status [text $object params status type]
        if {$status eq "active"} {
            if {![dict exists $live $thread]} { dict set live $thread "" }
            if {$thread eq [field $current threadId] && [field $current phase] ne "running"} { cancel }
        } elseif {$status in {idle notLoaded systemError}} { dict unset live $thread }
    }
    set id ""
    if {[huddle exists $object id]} { set id [json_dump [huddle get $object id]] }
    set response [expr {![huddle exists $object method] && $id ne ""}]
    set visible [expr {$method ne "" || ![dict exists $ids $id]}]
    if {$current eq ""} { return $visible }
    if {$method eq "" && $id ne "" && $id eq [field $current opId]} {
        if {!$response || [huddle exists $object error] || ![is $object dict result]} {
            stop "account reset API unavailable or failed"
        } else { limits_reply [huddle get $object result] }
        return 0
    }
    if {$id eq [field $current rpcId] && $method eq ""} {
        if {!$response || [huddle exists $object error] || ![is $object dict result turn] || \
            [text $object result turn id] eq "" || \
            [text $object result turn status] ni {inProgress failed completed interrupted}} {
            cancel
        } elseif {![field $current accepted]} {
            set turn [huddle get $object result turn]
            set turnId [text $turn id]
            if {$turnId eq [field $current previous] || \
                ([dict exists $::retry::finished [list [dict get $current threadId] $turnId]] && \
                 ![dict exists $current terminal]) || \
                ([field $current early] ne "" && [field $current early] ne $turnId)} { cancel; return $visible }
            dict set current accepted 1
            dict set current turnId $turnId
            # A running reply also establishes activity when turn/started is absent.
            # A terminal event received before this reply must remain authoritative.
            if {[text $turn status] eq "inProgress" && ![dict exists $current terminal] && \
                (![dict exists $live [dict get $current threadId]] || \
                 [field $live [dict get $current threadId]] eq "")} {
                dict set live [dict get $current threadId] $turnId
            }
            items $turn
            if {$current ne "" && [dict exists $current terminal]} {
                set terminal [dict get $current terminal]
                dict unset current terminal
                completed $terminal
            } elseif {$current ne "" && [text $turn status] ne "inProgress"} { cancel }
        } elseif {[text $object result turn id] ne [field $current turnId]} {
            cancel
        } else {
            items [huddle get $object result turn]
        }
        return $visible
    }
    if {$method in {account/updated account/gatewayOAuth/changed}} { cancel; return $visible }
    if {$method eq "account/rateLimits/updated"} {
        # Consume may itself publish an update. Only the subsequent full read
        # can prove recovery; sparse notifications never authorize continuation.
        if {[field $current phase] in {read consume_ready}} {
            stop "rate limits changed during recovery verification"
        } elseif {[field $current phase] eq "verify"} {
            dict set current limitsChanged 1
        } elseif {[field $current phase] eq "continue_reset"} {
            refresh_limits
        }
        return $visible
    }
    if {[text $object params threadId] ne [field $current threadId]} { return $visible }
    if {$method in {thread/closed thread/archived thread/deleted thread/reverted
        thread/settings/updated thread/queue/changed thread/goal/updated thread/goal/cleared
        thread/environment/connected thread/environment/disconnected model/rerouted}} {
        cancel
        return $visible
    }
    if {$method in {turn/started turn/completed}} {
        if {![is $object dict params turn]} { cancel; return $visible }
        set turn [huddle get $object params turn]
        set turnId [text $turn id]
        if {$turnId eq ""} { cancel; return $visible }
        if {$turnId ne [field $current turnId] && $turnId ne [field $current early] && \
            [dict exists $::retry::finished [list [field $current threadId] $turnId]]} { return $visible }
        if {![field $current accepted]} {
            # An early start is only a candidate until the reply binds its ID.
            # Retain a subsequent terminal snapshot, never a completion alone.
            if {($method eq "turn/started" && [text $turn status] ne "inProgress") || \
                ($method eq "turn/completed" && [field $current early] eq "") || \
                ($turnId eq [field $current previous]) || \
                ([field $current early] ne "" && [field $current early] ne $turnId)} { cancel; return $visible }
            dict set current early $turnId
            items $turn
            if {$current ne "" && $method eq "turn/completed" && ![dict exists $current terminal]} {
                dict set current terminal $turn
            }
            return $visible
        } elseif {$turnId ne [field $current turnId]} { cancel; return $visible }
        items $turn
        if {$current eq "" || [field $current done] || \
            [field $current phase] ni {running overload} || $method ne "turn/completed"} { return $visible }
        completed $turn
    } elseif {[string match "item/*" $method] || [string match "hook/*" $method] || \
        $method in {thread/compacted turn/plan/updated turn/diff/updated
            rawResponseItem/completed rawResponse/completed mcpServer/elicitation/request}} {
        set turnId [text $object params turnId]
        if {$turnId ne "" && $turnId ne [field $current turnId] && $turnId ne [field $current early] && \
            [dict exists $::retry::finished [list [field $current threadId] $turnId]]} { return $visible }
        set expected [field $current turnId]
        if {![field $current accepted]} { set expected [field $current early] }
        if {$turnId eq "" || $expected eq "" || $turnId ne $expected} { cancel; return $visible }
        if {$method in {item/started item/completed}} {
            if {![is $object dict params item] || [text $object params item type] eq ""} { cancel; return $visible }
            if {[text $object params item type] eq "userMessage"} {
                user_item [huddle get $object params item]
                return $visible
            }
        }
        if {[field $current phase] ne "running" || [dict exists $current terminal]} {
            cancel
        } else { dict set current progress 1 }
    }
    return $visible
}

proc automatic::rpc {method params phase} {
    variable current; variable timer; variable ids
    after cancel $timer
    set id [retry::next_id]
    set key [json_dump $id]
    dict set ids $key 1
    dict set current opId $key
    dict set current phase $phase
    if {$phase eq "verify"} { dict set current limitsChanged 0 }
    set timer [after 10000 [list automatic::stop "account recovery request timed out; its outcome is unknown"]]
    backend_send [json_dump [huddle create id $id method [huddle string $method] params $params]]
}

proc automatic::refresh_limits {} {
    variable current
    if {[dict get $current refreshes] == 0} {
        stop "rate limits kept changing before recovery could be verified"
    } else {
        dict incr current refreshes -1
        rpc account/rateLimits/read [huddle create] verify
    }
}

# A full read must identify the active account and the same ordinary quota.
# Only the confirmed OpenAI provider can use these account resets. A non-default
# quota alias also needs an exact model match. Unknown provenance stays stopped.
proc automatic::quota {result} {
    variable current; variable selection
    if {[field $selection threadId] ne [dict get $current threadId] || \
        [field $selection provider] ne "openai"} { return "" }
    if {[text $result accountId] eq "" || ![is $result dict rateLimits]} { return "" }
    set quota [huddle get $result rateLimits]
    set id [text $quota limitId]
    set params [huddle get [dict get $current request] params]
    set model [text $params collaborationMode settings model]
    if {$model eq ""} { set model [text $params model] }
    if {$model eq ""} { set model [field $selection model] }
    if {$id eq "" || ($id ne "codex" && ($model eq "" || $model ne [text $quota normalModelSlug])) || \
        ![is $quota boolean spendControlReached] || [huddle get_stripped $quota spendControlReached] ne "false"} { return "" }
    if {[huddle exists $result rateLimitsByLimitId] && ![is $result null rateLimitsByLimitId]} {
        if {![is $result dict rateLimitsByLimitId $id]} { return "" }
        set bucket [huddle get $result rateLimitsByLimitId $id]
        foreach key {limitId spendControlReached rateLimitReachedType} {
            if {![huddle exists $quota $key] || ![huddle exists $bucket $key] || \
                ![huddle equal [huddle get $quota $key] [huddle get $bucket $key]]} { return "" }
        }
    }
    return $quota
}

proc automatic::limits_reply {result} {
    variable current; variable timer
    after cancel $timer
    set timer ""
    set phase [dict get $current phase]
    dict unset current opId
    if {$phase eq "consume"} {
        set outcome [text $result outcome]
        if {$outcome in {reset alreadyRedeemed}} {
            dict set current refreshes 1
            rpc account/rateLimits/read [huddle create] verify
        } else {
            switch -- $outcome {
                noCredit { stop "no earned rate-limit resets are available" }
                nothingToReset { stop "the server found nothing resettable; no reset confirmed" }
                default { stop "reset redemption returned an unknown outcome" }
            }
        }
        return
    }
    if {$phase eq "verify" && [dict get $current limitsChanged]} { refresh_limits; return }
    set quota [quota $result]
    if {$quota eq "" || ![is $result boolean ordinaryUsageAllowed]} {
        stop "account or ordinary quota eligibility is unknown"
        return
    }
    set account [text $result accountId]
    set limit [text $quota limitId]
    if {$phase eq "verify"} {
        if {$account ne [dict get $current account] || $limit ne [dict get $current limit] || \
            [huddle get_stripped $result ordinaryUsageAllowed] ne "true" || \
            ![is $quota null rateLimitReachedType]} {
            stop "refreshed limits did not verify restored ordinary usage"
        } else { queue continue_reset }
        return
    }
    if {[huddle get_stripped $result ordinaryUsageAllowed] ne "false" || \
        [text $quota rateLimitReachedType] ne "rate_limit_reached"} {
        stop "ordinary usage is no longer exhausted or this limit is not resettable; no credit consumed"
        return
    }
    if {![is $result number rateLimitResetCredits availableCount] || \
        ![regexp {^[0-9]+$} [huddle get_stripped $result rateLimitResetCredits availableCount]]} {
        stop "available reset count is unknown"
        return
    }
    if {[huddle get_stripped $result rateLimitResetCredits availableCount] == 0} {
        stop "no earned rate-limit resets are available"
        return
    }
    dict set current account $account
    dict set current limit $limit
    set params [huddle create idempotencyKey [retry::next_id]]
    if {[is $result list rateLimitResetCredits credits]} {
        set credits [huddle get $result rateLimitResetCredits credits]
        for {set i 0} {$i < [huddle llength $credits]} {incr i} {
            set credit [huddle get $credits $i]
            if {[text $credit status] eq "available" && [text $credit resetType] eq "codexRateLimits" && \
                [text $credit id] ne ""} { huddle set params creditId [huddle get $credit id]; break }
        }
    }
    # Keep one stable logical redemption. There are no automatic consume retries,
    # including after timeouts where the server may already have redeemed it.
    dict set current redemption $params
    queue consume_ready
}

proc automatic::advance {} {
    variable current; variable timer
    set timer ""
    if {$current eq "" || ![field $current accepted]} { return }
    switch -- [dict get $current phase] {
        read_ready { rpc account/rateLimits/read [huddle create] read }
        consume_ready { rpc account/rateLimitResetCredit/consume [dict get $current redemption] consume }
        continue_stop - continue_reset - continue_overload {
            set overload [expr {[dict get $current phase] eq "continue_overload"}]
            set delay $::retry::delay
            set original [huddle get [dict get $current request] params]
            set params [huddle create threadId [huddle get $original threadId] \
                clientUserMessageId [retry::next_id] \
                input [huddle list [huddle create type [huddle string text] text [huddle string continue] \
                    text_elements [huddle list]]]]
            # Copy settings only. Never replay input, tool output, attachments,
            # additional context, source classifications or parent identities.
            foreach key {disabledPluginIds environments cwd runtimeWorkspaceRoots approvalPolicy
                approvalsReviewer sandboxPolicy permissions model serviceTier serviceTierForTurn
                effort summary personality outputSchema collaborationMode multiAgentMode cyberAccessProgram} {
                if {[huddle exists $original $key]} { huddle set params $key [huddle get $original $key] }
            }
            set id [retry::next_id]
            set request [huddle create id $id method [huddle string turn/start] params $params]
            set key [json_dump $id]
            dict set ::automatic::ids $key 1
            # Each turn starts fresh; account operations and verification state
            # belong only to the failure that triggered this continuation.
            set current [dict create request $request rpcId $key threadId [dict get $current threadId] \
                turnId "" previous [dict get $current turnId] early "" userId "" \
                phase running accepted 0 generated 1 done 0]
            retry::client [json_dump $request] 0
            if {$overload} { set ::retry::delay $delay }
            backend_send [json_dump $request]
        }
    }
}

# Recovery outlives retry cancellation, disconnection and backend cleanup.
namespace eval recovery {
    variable target ""
    variable pending {}
    variable deleted {}
    variable seen {}
    variable yolo 0
    variable launcher [file normalize [info script]]
}

proc recovery::client {json} {
    variable target; variable pending; variable deleted; variable seen; variable yolo
    set object [::huddle::json2huddle $json]
    if {[huddle type $object] ne "dict" || ![huddle exists $object method] || \
        [huddle type $object method] ne "string"} { return }
    set message [json::json2dict $json]
    set method [field $message method]
    set params [field $message params]
    if {$method in {thread/start thread/resume thread/fork}} {
        set ::automatic::selection {}
        # A pending activation is not proof that either the old or new UI
        # selection is resumable. Only the latest successful reply can select it.
        set target ""
        set pending {}
        if {[huddle exists $object id] && [huddle type $object id] in {string number} && \
            [huddle exists $object params] && [huddle type $object params] eq "dict"} {
            set id [json_dump [huddle get $object id]]
            if {![dict exists $seen $id]} {
                set expected ""
                if {$method eq "thread/resume" && \
                    (![huddle exists $object params history] || [huddle type $object params history] eq "null") && \
                    (![huddle exists $object params path] || [huddle type $object params path] eq "null" || \
                     ([huddle type $object params path] eq "string" && \
                      [huddle get_stripped $object params path] eq ""))} { set expected [field $params threadId] }
                set pending [dict create rpcId $id expected $expected \
                    ephemeral [expr {[field $params ephemeral] eq "true"}]]
                if {$method ne "thread/start" && (![huddle exists $object params threadId] || \
                    [huddle type $object params threadId] ne "string" || \
                    [huddle get_stripped $object params threadId] eq "")} { set pending {} }
            }
            # Reused activation IDs cannot distinguish a late duplicate reply.
            dict set seen $id 1
        }
    }
    if {![huddle exists $object params] || [huddle type $object params] ne "dict"} { return }
    if {$method in {thread/delete thread/archive}} {
        set id [field $params threadId]
        dict set deleted $id 1
        if {$target eq $id} { set target "" }
    }
    if {[string match "turn/*" $method] && \
        [field $params threadId] ne "" && [field $params threadId] ne $target} {
        set target ""
        set pending {}
    }
    # Once permissions change manually, never reintroduce launch escalation.
    foreach {key desired} {approvalPolicy never sandbox danger-full-access sandboxPolicy dangerFullAccess} {
        if {[dict exists $params $key] && [huddle type $object params $key] ne "null"} {
            set value [dict get $params $key]
            if {$key eq "sandboxPolicy"} { set value [field $value type] }
            if {$value ne $desired} { set yolo 0 }
        }
    }
    if {[dict exists $params permissions] && [huddle type $object params permissions] ne "null"} { set yolo 0 }
}

# Automatic selection and activity snapshots require strict envelope validation.
proc recovery::server {object message {automaticValid 0}} {
    variable target; variable pending; variable deleted; variable yolo
    if {[field $message method] eq "thread/settings/updated" && \
        [field $message params threadId] eq $target} {
        if {$automaticValid} { automatic::selected $object $target params threadSettings }
        if {![huddle exists $object params threadSettings approvalPolicy] || \
            [huddle type $object params threadSettings approvalPolicy] ne "string" || \
            [huddle get_stripped $object params threadSettings approvalPolicy] ne "never" || \
            ![huddle exists $object params threadSettings sandboxPolicy type] || \
            [huddle type $object params threadSettings sandboxPolicy type] ne "string" || \
            [huddle get_stripped $object params threadSettings sandboxPolicy type] ne "dangerFullAccess"} { set yolo 0 }
    }
    # Reuse Tcllib's dictionary; Huddle is needed only for typed field access.
    if {[field $message method] in {thread/deleted thread/archived}} {
        set id [field $message params threadId]
        dict set deleted $id 1
        if {$target eq $id} { set target "" }
    }
    if {[huddle exists $object method] || ![huddle exists $object id] || \
        [json_dump [huddle get $object id]] ne [field $pending rpcId]} { return }
    set expected [field $pending expected]
    set ephemeral [field $pending ephemeral]
    set pending {}
    if {[huddle exists $object error] || \
        ![huddle exists $object result thread id] || \
        [huddle type $object result] ne "dict" || [huddle type $object result thread] ne "dict" || \
        [huddle type $object result thread id] ne "string"} { return }
    set id [huddle get_stripped $object result thread id]
    if {$id eq "" || ($expected ne "" && $id ne $expected)} { return }
    if {$automaticValid} { automatic::snapshot [huddle get $object result] }
    if {$ephemeral || [dict exists $deleted $id] || \
        [field $message result thread ephemeral] eq "true"} { return }
    set target $id
    if {$automaticValid} { automatic::selected $object $id result }
    if {![huddle exists $object result approvalPolicy] || \
        [huddle type $object result approvalPolicy] ne "string" || \
        [huddle get_stripped $object result approvalPolicy] ne "never" || \
        ![huddle exists $object result sandbox type] || \
        [huddle type $object result sandbox] ne "dict" || \
        [huddle type $object result sandbox type] ne "string" || \
        [huddle get_stripped $object result sandbox type] ne "dangerFullAccess"} { set yolo 0 }
}

proc recovery::invocation {} {
    variable launcher
    set installed [lindex [auto_execok codex-retry] 0]
    if {$installed ne "" && [file pathtype $installed] eq "absolute" && ![catch {
        file stat $installed a
        file stat $launcher b
        expr {$a(dev) == $b(dev) && $a(ino) == $b(ino)}
    } same] && $same} { return codex-retry }
    return $launcher
}

proc shell_quote {value} {
    if {[regexp {^[a-zA-Z0-9_./:-]+$} $value]} { return $value }
    return "'[string map [list ' {'\''}] $value]'"
}

proc recovery::advice {} {
    variable target; variable yolo
    set arguments [list [invocation] resume]
    if {[string match -* $target]} {
        if {$yolo} { lappend arguments --yolo }
        lappend arguments -- $target
    } else {
        if {$target ne ""} { lappend arguments $target }
        if {$yolo && $target ne ""} { lappend arguments --yolo }
    }
    set quoted {}
    foreach argument $arguments { lappend quoted [shell_quote $argument] }
    set heading "To resume this session, run:"
    if {$target eq ""} { set heading "To choose a saved session, run:" }
    return "$heading\n  [join $quoted { }]\n"
}

# Native exits restore bracketed paste before the combined-PTY exit
# epilogue. Forward live bytes immediately, retaining only a split marker.
# After restoration, buffer only a possible native disconnect prefix and its
# bounded epilogue. Unrelated output and TUI re-entry flush it immediately.
# No terminal text participates in retry decisions.
namespace eval presentation {
    variable buffer ""
    variable held 0
    variable replaced 0
    variable endpoint ""
    variable boundary "\033\[?2004l"
    variable disconnects {
        {Disconnected from this task. The current turn was stopped.}
        {Disconnected from this task. Any running work continues.}
        {Disconnected from this task. Work may still be running.}
    }
}
proc presentation::write {bytes} {
    puts -nonewline stdout $bytes
    flush stdout
}
proc presentation::probe {} {
    variable buffer; variable disconnects
    # An external terminal application may await a cursor-query response.
    while {[regexp {^(?:\x1b\[[0-?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|[ \t\r\n]+)} $buffer leading]} {
        write $leading
        set buffer [string range $buffer [string length $leading] end]
    }
    # Native title/state OSCs can split anywhere, including inside ESC-backslash.
    # feed bounds this incomplete leading prefix just like the epilogue itself.
    if {[regexp {^\x1b\][^\x07\x1b]*(?:\x1b)?$} $buffer]} { return 1 }
    regsub -all {\x1b\[[0-?]*[ -/]*[@-~]} $buffer {} text
    # A split restoration/color sequence can precede the native prefix.
    regsub {\x1b(?:\[[0-?]*[ -/]*)?$} $text {} text
    set text [string trimleft $text]
    if {$text eq ""} { return 1 }
    foreach prefix $disconnects {
        if {[string first $text $prefix] == 0 || \
            ([string first $prefix $text] == 0 && \
             [regexp {^[ \t]*(?:\r|\n|$)} [string range $text [string length $prefix] end]])} { return 1 }
    }
    return 0
}
proc presentation::feed {bytes} {
    variable buffer; variable held; variable boundary
    append buffer $bytes
    if {$held} {
        if {[string first "\033\[?2004h" $buffer] < 0 && [string length $buffer] <= 16384 && \
            [probe]} { return }
        # An editor prompt must be visible before it can receive input.
        set held 0
    }
    set index [string last $boundary $buffer]
    if {$index >= 0} {
        set end [expr {$index + [string length $boundary] - 1}]
        write [string range $buffer 0 $end]
        set buffer [string range $buffer $end+1 end]
        set held 1
        if {[string length $buffer] <= 16384 && [string first "\033\[?2004h" $buffer] < 0 && \
            [probe]} { return }
        set held 0
    }
    set retain 0
    for {set n 1} {$n < [string length $boundary]} {incr n} {
        if {[string range $buffer end-[expr {$n - 1}] end] eq [string range $boundary 0 $n-1]} { set retain $n }
    }
    set end [expr {[string length $buffer] - $retain - 1}]
    write [string range $buffer 0 $end]
    set buffer [string range $buffer $end+1 end]
}
proc presentation::finish {} {
    variable buffer; variable held; variable replaced; variable endpoint; variable disconnects
    # Match individual complete lines only inside the characterized exit
    # channel. ANSI is ignored for comparison; every retained byte stays intact.
    set lines [regexp -all -inline {[^\r\n]*(?:\r\n|\r|\n)|[^\r\n]+$} $buffer]
    set plain {}
    foreach line $lines {
        regsub -all {\x1b\[[0-?]*[ -/]*[@-~]} $line {} text
        lappend plain [string trim $text]
    }
    set disconnect -1
    set reconnect -1
    set command -1
    set stop -1
    set prefix "codex --remote $endpoint --remote-auth-token-env CODEX_RETRY_TOKEN"
    set stopCommand "$prefix agents"
    for {set i 0} {$i < [llength $plain]} {incr i} {
        set line [lindex $plain $i]
        if {$disconnect < 0 && $line in $disconnects} { set disconnect $i }
        if {$disconnect >= 0 && $line eq "To reconnect, run:"} { set reconnect $i }
        if {$reconnect >= 0 && ($line eq $prefix || $line eq "$prefix resume" || \
            [string first "$prefix resume " $line] == 0)} { set command $i }
        set index [string first $stopCommand $line]
        if {$command >= 0 && $index >= 0 && \
            [regexp {^(?:$|[ \t`'".,])} [string range $line [expr {$index + [string length $stopCommand]}] end]]} {
            set stop $i
            break
        }
    }
    if {$held && !$replaced && $disconnect >= 0 && $reconnect > $disconnect && \
        $command > $reconnect} {
        set remove [list $disconnect $reconnect $command]
        if {$stop > $command} {
            lappend remove $stop
            set previous [expr {$stop - 1}]
            while {$previous > $command && [lindex $plain $previous] eq ""} { incr previous -1 }
            if {$previous > $command && [lindex $plain $stop] eq $stopCommand && \
                [lindex $plain $previous] eq "To stop this task, run:"} { lappend remove $previous }
        }
        # Restoration/cursor sequences can share a line with the native text.
        # Keep them, including color resets, even on the replaced lines.
        foreach index $remove {
            lset lines $index [join [regexp -all -inline {\x1b\[[0-?]*[ -/]*[@-~]} [lindex $lines $index]] ""]
        }
        lset lines $disconnect "[lindex $lines $disconnect][encoding convertto utf-8 [string map [list \n \r\n] [recovery::advice]]]"
        set replaced 1
    }
    write [join $lines ""]
    set buffer ""
    set held 0
}

namespace eval resume {
    variable armed 0
    variable pending {}
    variable failure ""
}

proc resume::reset {} {
    variable armed; variable pending; variable failure
    set armed 0
    set pending {}
    set failure ""
}

proc resume::reject {message} {
    variable armed; variable failure
    set armed 0
    set failure $message
    error $message
}

# Only the launch resume is overridden. Later settings and turns stay native-owned.
proc resume::client {json} {
    variable armed; variable pending; variable failure
    if {$failure ne ""} { error $failure }
    if {!$armed && $pending eq ""} { return $json }
    set message [json::json2dict $json]
    set method [field $message method]
    if {$method eq ""} { return $json }
    if {$armed && $method eq "thread/resume"} {
        set armed 0
        set object [::huddle::json2huddle $json]
        if {[catch {
            set id [huddle get $object id]
            set thread [huddle get $object params threadId]
            set valid [expr {[huddle type [huddle get $object params]] eq "dict" && \
                [huddle type $id] in {string number} && \
                [huddle type $thread] eq "string" && [huddle get_stripped $thread] ne ""}]
        }] || !$valid} { reject "cannot identify the launch resume for --yolo" }
        if {[dict exists $message params permissions] && \
            [huddle type [huddle get $object params permissions]] ne "null"} {
            reject "resume --yolo cannot be combined with a named permissions profile"
        }
        huddle set object params approvalPolicy [huddle string never]
        huddle set object params sandbox [huddle string danger-full-access]
        set pending [dict create rpcId [json_dump $id] threadId [huddle get_stripped $thread]]
        return [json_dump $object]
    }
    if {[string match "turn/*" $method] || $method in {
        review/start thread/shellCommand thread/compact/start thread/inject_items
        thread/queue/add thread/queue/update thread/queue/start
        thread/realtime/start thread/realtime/appendText
        thread/realtime/appendAudio thread/realtime/appendSpeech
        thread/goal/set thread/prediction/request
        command/exec process/spawn process/writeStdin mcpServer/tool/call
    }} { reject "work requested before resume --yolo permissions were confirmed" }
    if {$method in {
        thread/start thread/resume thread/fork thread/revert thread/archive
        thread/delete thread/unsubscribe thread/settings/update
    }} {
        set armed 0
        if {$pending ne ""} { reject "resume --yolo verification canceled by a manual thread or permission change" }
    }
    return $json
}

# A failure is latched before forwarding an error, so no callback can leak work.
proc resume::acknowledge {object} {
    variable pending; variable failure
    if {[huddle exists $object error]} {
        set message ""
        catch {set message [huddle get_stripped $object error message]}
        set failure "server rejected resume --yolo: $message"
        return 1
    }
    if {[catch {
        set result [huddle get $object result]
        set thread [huddle get $result thread id]
        set approval [huddle get $result approvalPolicy]
        set sandbox [huddle get $result sandbox type]
        set valid [expr {[huddle type $result] eq "dict" && \
            [huddle type [huddle get $result thread]] eq "dict" && \
            [huddle type $thread] eq "string" && \
            [huddle get_stripped $thread] eq [dict get $pending threadId] && \
            [huddle type $approval] eq "string" && [huddle get_stripped $approval] eq "never" && \
            [huddle type [huddle get $result sandbox]] eq "dict" && \
            [huddle type $sandbox] eq "string" && [huddle get_stripped $sandbox] eq "dangerFullAccess"}]
    }] || !$valid} {
        set failure "server did not confirm resume --yolo permissions for the requested thread"
        return 0
    }
    set pending {}
    return 1
}

proc retry::reset {} {
    variable current; variable timer; variable delay
    after cancel $timer
    set timer ""
    set current {}
    set delay 5000
}

proc retry::client {json {manual 1}} {
    variable current; variable usedIds
    set object [::huddle::json2huddle $json]
    set message [json::json2dict $json]
    # Canceling an automatic chain may clear current before steering is recorded.
    set prior $current
    if {$manual} {
        if {[dict get $::automatic::flags auto_reset_limit] || \
            [dict get $::automatic::flags auto_continue_after_stop]} {
            if {[catch {automatic::decode $json} typed]} {
                automatic::cancel
            } else { automatic::client $typed }
        } else { automatic::client $object }
    }
    set method [field $message method]
    if {([string match "account/*" $method] && ![automatic::read_only $method]) || \
        $method in {modelProvider/auth/set modelProvider/auth/clear}} { reset }
    if {$method ne "" && [dict exists $message id]} {
        dict set usedIds [json_dump [huddle get $object id]] 1
    }
    set threadId [field $message params threadId]
    if {$current ne "" && $method ne "" && $threadId ne "" && \
        $threadId ne [field $current threadId] && \
        ![automatic::read_only $method]} { reset }
    if {[string match "turn/*" $method] || $method in {
        thread/start thread/resume thread/fork thread/revert thread/archive
        thread/delete thread/unsubscribe thread/compact/start thread/inject_items
        thread/settings/update thread/goal/set thread/goal/clear review/start thread/shellCommand
        thread/queue/add thread/queue/update thread/queue/delete
        thread/queue/reorder thread/queue/start
        thread/realtime/start thread/realtime/stop thread/realtime/appendText
        thread/realtime/appendAudio thread/realtime/appendSpeech
    }} {
        if {$threadId ne "" && $threadId ne [field $prior threadId]} { set prior {} }
        set busy [expr {$prior ne "" && [field $prior status] in {awaiting inProgress}}]
        set previous [field $prior turnId]
        # Context invalidation can discard the tracker while its turn is still
        # live. Steering that work must not become eligible for fresh replay.
        if {[dict exists $::automatic::live $threadId]} {
            set busy 1
            set previous [dict get $::automatic::live $threadId]
        }
        reset
        if {$method eq "turn/start" && [dict exists $message id] && \
            [field $message params threadId] ne "" && [field $message params input] ne ""} {
            set current [dict create request $object \
                rpcId [json_dump [huddle get $object id]] \
                threadId [field $message params threadId] turnId "" status awaiting \
                accepted 0 progress $busy overloaded 0 previous $previous observations {}]
        }
    }
}

proc retry::progress {} {
    variable current; variable timer
    dict set current progress 1
    after cancel $timer
    set timer ""
}

# Keep early notifications until a start response or notification identifies the turn.
proc retry::observe {turnId key value} {
    variable current
    if {$turnId ne "" && ($turnId eq [field $current turnId] || \
        ([field $current turnId] eq "" && $turnId ne [field $current previous]))} {
        dict set current observations $turnId $key $value
    }
}

# App Server supplies the default empty spans when echoing submitted text.
proc retry::user_input {input} {
    if {[huddle type $input] ne "list"} { error "invalid user input" }
    for {set i 0} {$i < [huddle llength $input]} {incr i} {
        if {[huddle exists $input $i type] && [huddle type $input $i type] eq "string" && \
            [huddle get_stripped $input $i type] eq "text" && \
            ![huddle exists $input $i text_elements]} {
            huddle set input $i text_elements [huddle list]
        }
    }
    return $input
}

# One matching user item is ours; another item or changed content is steering.
# Retain its identity per turn so early events and duplicate snapshots agree.
proc retry::user_item {turnId item} {
    variable current
    if {[catch {
        set params [huddle get [dict get $current request] params]
        set id [huddle get_stripped $item id]
        set matches [expr {[huddle type $item type] eq "string" && \
            [huddle get_stripped $item type] eq "userMessage" && \
            [huddle type $item id] eq "string" && $id ne "" && \
            [huddle equal [user_input [huddle get $params input]] \
                [user_input [huddle get $item content]]]}]
        if {$matches && [huddle exists $params clientUserMessageId] && \
            [huddle type $params clientUserMessageId] ne "null"} {
            set matches [expr {[huddle type $params clientUserMessageId] eq "string" && \
                [huddle type $item clientId] eq "string" && \
                [huddle get_stripped $item clientId] eq [huddle get_stripped $params clientUserMessageId]}]
        }
    }] || !$matches} {
        observe $turnId progress 1
        return
    }
    set previous [field $current observations $turnId userId]
    if {$previous ne "" && $previous ne $id} {
        observe $turnId progress 1
    } else {
        observe $turnId userId $id
    }
}

proc retry::items {turn json args} {
    set index -1
    foreach item [field $turn items] {
        incr index
        if {[field $item type] eq "userMessage"} {
            if {![info exists object]} { set object [::huddle::json2huddle $json] }
            user_item [field $turn id] [huddle get $object {*}$args items $index]
        } else {
            observe [field $turn id] progress 1
        }
    }
}

proc retry::update {} {
    variable current; variable finished
    if {[field $current accepted]} {
        dict for {turn observed} [dict get $current observations] {
            if {$turn ne [field $current turnId] && [field $observed activity] eq "1" && \
                ![dict exists $finished [list [field $current threadId] $turn]]} {
                reset
                return
            }
        }
    }
    set observed [field $current observations [field $current turnId]]
    if {[field $observed progress] eq "1"} { progress }
    if {[dict exists $observed completion]} {
        set turn [dict get $observed completion]
        dict set current status [field $turn status]
        dict set current overloaded [expr {[field $turn error codexErrorInfo] eq "serverOverloaded"}]
        if {[field $current status] ne "failed" || ![field $current overloaded]} {
            reset
            return
        }
    }
    schedule
}

proc retry::schedule {} {
    variable current; variable timer; variable delay
    if {$timer eq "" && [field $current accepted] && \
        [field $current status] eq "failed" && [field $current overloaded] && \
        ![field $current progress]} {
        set timer [after $delay retry::fire]
        set delay [expr {min(1800000, $delay * 2)}]
    }
}

proc retry::fire {} {
    variable current; variable timer; variable internal
    set timer ""
    if {[field $current accepted] ne "1" || [field $current status] ne "failed" || \
        [field $current overloaded] ne "1" || [field $current progress]} { return }
    set request [dict get $current request]
    set previous [dict get $current rpcId]
    set id [next_id]
    set rpcId [json_dump $id]
    huddle set request id $id
    dict set internal $rpcId 1
    foreach {key value} [list request $request rpcId $rpcId \
        previous [dict get $current turnId] turnId "" status awaiting \
        accepted 0 overloaded 0 observations {}] { dict set current $key $value }
    automatic::replay $request $previous
    backend_send [json_dump $request]
}

# Recognize App Server's two-field replies without decoding large catalogs.
# Strings are opaque; check container boundaries so later envelope fields
# (including method or a duplicate ID) always use the full Tcllib parser.
proc retry::response_id {json} {
    if {![regexp {^[ \t\r\n]*\{[ \t\r\n]*"id"[ \t\r\n]*:[ \t\r\n]*("(?:[^"\\\x00-\x1f]|\\(?:["\\/bfnrt]|u[0-9A-Fa-f]{4}))*"|-?(?:0|[1-9][0-9]*))[ \t\r\n]*,[ \t\r\n]*"(?:result|error)"[ \t\r\n]*:[ \t\r\n]*} \
        [string range $json 0 255] header encodedId]} { return "" }
    if {[catch {set id [json_dump [::huddle::json2huddle $encodedId]]}]} { return "" }
    set payload [string range $json [string length $header] end]
    if {[string index $payload 0] ni {\{ \[}} { return "" }
    regsub -all {"(?:[^"\\\x00-\x1f]|\\(?:["\\/bfnrt]|u[0-9A-Fa-f]{4}))*"} $payload 0 structure
    if {[regexp {["\\]} $structure]} { return "" }
    set closing ""
    foreach span [regexp -all -inline -indices {[][{}]} $structure] {
        set index [lindex $span 0]
        set character [string index $structure $index]
        switch -- $character {
            \{ { append closing \} }
            \[ { append closing \] }
            default {
                if {$character ne [string index $closing end]} { return "" }
                set closing [string range $closing 0 end-1]
                if {$closing eq ""} {
                    if {[regexp {^[ \t\r\n]*\}[ \t\r\n]*$} \
                        [string range $structure [expr {$index + 1}] end]]} { return $id }
                    return ""
                }
            }
        }
    }
    return ""
}

# Hide internal replay replies and unconfirmed resume success; forward other traffic.
proc retry::server {json} {
    variable current; variable internal; variable finished
    set id [response_id $json]
    if {$id ne "" && $id ne [field $::resume::pending rpcId] && \
        $id ne [field $::recovery::pending rpcId] && ![dict exists $internal $id] && \
        $id ne [field $::automatic::current rpcId] && ![dict exists $::automatic::ids $id] && \
        ($current eq "" || $id ne [field $current rpcId])} { return 1 }
    set message [json::json2dict $json]
    set method [field $message method]
    # Legacy compaction is turn progress, just like a contextCompaction item.
    # Require unambiguous IDs even when optional recovery is disabled.
    if {$method eq "thread/compacted" && ([catch {automatic::decode $json} compacted] || \
        [automatic::text $compacted params threadId] eq "" || \
        [automatic::text $compacted params turnId] eq "")} {
        automatic::cancel
        reset
        return 1
    }
    if {$method in {account/updated account/gatewayOAuth/changed}} { reset }
    set automaticVisible 1
    set automaticValid 0
    if {$::automatic::current ne "" || $::automatic::ids ne "" || \
        [dict get $::automatic::flags auto_reset_limit] || [dict get $::automatic::flags auto_continue_after_stop]} {
        if {[catch {automatic::decode $json} typed]} {
            set ::automatic::selection {}
            if {$::automatic::current ne "" && \
                [field $::automatic::current phase] ni {running overload}} {
                automatic::stop "ambiguous protocol data canceled automatic recovery"
            } else { automatic::cancel }
            set automaticVisible [expr {![dict exists $::automatic::ids $id]}]
        } else {
            set automaticValid 1
            set automaticVisible [automatic::server $typed]
        }
    }
    set response [expr {$method eq "" && [dict exists $message id] && \
        ([dict exists $message result] || [dict exists $message error])}]
    if {[dict exists $message id] && ($method eq "" || $::resume::pending ne "")} {
        set object [::huddle::json2huddle $json]
        set id [json_dump [huddle get $object id]]
        if {$id eq [field $::resume::pending rpcId]} {
            # Only a non-empty JSON string identifies a colliding server request.
            set hasMethod [huddle exists $object method]
            set serverRequest [expr {$hasMethod && [huddle type $object method] eq "string" && \
                [huddle get_stripped $object method] ne ""}]
            if {!$serverRequest} {
                if {!$response || $hasMethod} {
                    set ::resume::failure "malformed acknowledgement for resume --yolo"
                    return 0
                }
                set visible [resume::acknowledge $object]
                if {$::resume::failure eq ""} { recovery::server $object $message $automaticValid }
                return $visible
            }
        }
    }
    if {($response && $id eq [field $::recovery::pending rpcId]) || \
        $method in {thread/deleted thread/archived thread/settings/updated}} {
        recovery::server [::huddle::json2huddle $json] $message $automaticValid
    }
    set visible [expr {$automaticVisible && (!$response || ![dict exists $internal $id])}]
    if {$response} { dict unset internal $id }
    set params [field $message params]
    set turnId [field $params turn id]
    set freshCompletion 0
    if {$method eq "turn/completed" && $turnId ne ""} {
        set key [list [field $params threadId] $turnId]
        set freshCompletion [expr {![dict exists $finished $key]}]
        dict set finished $key 1
    }
    if {$current eq ""} { return $visible }
    if {$response && $id eq [dict get $current rpcId]} {
        if {[dict exists $message error]} {
            reset
        } else {
            set turn [field $message result turn]
            set turnId [field $turn id]
            if {$turnId eq "" || $turnId eq [field $current previous] || \
                ([field $current turnId] ne "" && \
                $turnId ne [field $current turnId])} { reset; return $visible }
            dict set current accepted 1
            dict set current turnId $turnId
            if {[field $current status] eq "awaiting"} { dict set current status inProgress }
            items $turn $json result turn
            update
        }
        return $visible
    }
    if {[field $params threadId] ne [dict get $current threadId]} { return $visible }
    if {$method in {thread/closed thread/archived thread/deleted thread/reverted
        thread/settings/updated thread/queue/changed thread/goal/updated thread/goal/cleared}} {
        reset
    } elseif {$method eq "turn/started" && $turnId ne "" && \
        $turnId ne [field $current previous] && \
        (![dict exists $finished [list [field $params threadId] $turnId]] || \
        [dict exists $current observations $turnId completion])} {
        if {[field $current status] eq "awaiting" && \
            ([field $current turnId] eq "" || $turnId eq [field $current turnId])} {
            dict set current turnId $turnId
            dict set current status inProgress
        } elseif {$turnId ne [field $current turnId]} {
            reset
        }
        if {$current ne ""} { items [field $params turn] $json params turn; update }
    } elseif {$method eq "turn/completed" && $turnId ne ""} {
        if {$freshCompletion && [field $current status] eq "failed" && \
            $turnId ne [field $current turnId]} { reset; return $visible }
        if {$freshCompletion || $turnId eq [field $current turnId] || \
            [dict exists $current observations $turnId completion]} {
            items [field $params turn] $json params turn
            if {$freshCompletion} { observe $turnId completion [field $params turn] }
            update
        }
    } else {
        set turnId [field $params turnId]
        # Keep pre-ack activity even after turn/started, for reconciliation.
        if {$turnId ne "" && \
            ![dict exists $finished [list [field $params threadId] $turnId]] && \
            ([string match "item/*" $method] || [string match "hook/*" $method] || \
             $method in {thread/compacted turn/plan/updated turn/diff/updated rawResponseItem/completed
                 rawResponse/completed mcpServer/elicitation/request})} {
            if {![field $current accepted]} {
                if {$turnId ne "null"} { dict set current observations $turnId activity 1 }
            } elseif {$turnId ne [field $current turnId]} {
                reset
                return $visible
            }
        }
        if {$method in {hook/started hook/completed mcpServer/elicitation/request} && \
            $turnId in {"" null}} {
            # An unscoped hook or elicitation in this thread makes replay ambiguous.
            progress
        } elseif {$turnId ne "" && ($turnId eq [field $current turnId] || \
            [dict exists $current observations $turnId completion] || \
            ![dict exists $finished [list [field $params threadId] $turnId]]) && \
            ([string match "item/*" $method] || $method in {
                thread/compacted hook/started hook/completed turn/plan/updated turn/diff/updated
                rawResponseItem/completed rawResponse/completed mcpServer/elicitation/request
            })} {
            if {$method in {item/started item/completed} && [field $params item type] eq "userMessage"} {
                user_item $turnId [huddle get [::huddle::json2huddle $json] params item]
            } else {
                observe $turnId progress 1
            }
            update
        }
    }
    return $visible
}

proc backend_send {json} {
    if {[websocket::send $::backend text [json_dump [::huddle::json2huddle $json]]] < 0} {
        error "shared app-server proxy send failed"
    }
}

proc backend_event {channel type json} {
    if {![info exists ::backend] || $::backend ne $channel} { return }
    if {[catch {
        switch -- $type {
            text {
                if {![info exists ::client]} { error "shared app-server sent data before TUI connection" }
                set visible [retry::server $json]
                set failure $::resume::failure
                if {$visible && [websocket::send $::client text $json] < 0} {
                    if {$failure ne ""} { error $failure }
                    cleanup
                }
                if {$failure ne ""} { error $failure }
            }
            close - disconnect {
                set ::proxyError 1
                if {![info exists ::proxyMessage]} { set ::proxyMessage "shared app-server proxy disconnected" }
                # Release the connection and cancel retries, but let the native
                # TUI drain its disconnect output through the normal exit path.
                cleanup
            }
            error - timeout - binary { error "shared app-server proxy transport failed" }
        }
    } message]} { bgerror $message }
}

proc connection {socket type message} {
    # Tcllib logs callback exceptions; make proxy failures terminate visibly.
    if {[catch {
        switch -- $type {
            connect {
                set ::client $socket
            }
            text {
                set message [resume::client $message]
                recovery::client $message
                retry::client $message
                backend_send $message
            }
            disconnect - close { cleanup }
            error - timeout { error $message }
        }
    } result]} { bgerror $result }
}

# The native picker opens a temporary client. A separate owned byte tunnel keeps
# its initialize, RPC IDs and lifetime out of the main TUI's recovery state.
namespace eval auxiliary {
    variable clients
    variable backends
    variable keys
}

proc auxiliary::close {socket} {
    variable clients; variable backends; variable keys
    if {![info exists clients($socket)]} { return }
    set channel $clients($socket)
    unset clients($socket) backends($channel)
    unset -nocomplain keys($socket)
    catch {websocket::configure $socket -keepalive 0}
    catch {websocket::close $socket}
    catch {::close $socket}
    close_backend $channel
}

proc auxiliary::event {socket type message} {
    variable clients
    if {![info exists clients($socket)]} { return }
    if {[catch {
        switch -- $type {
            text {
                set message [json_dump [::huddle::json2huddle $message]]
                if {[websocket::send $clients($socket) text $message] < 0} { close $socket }
            }
            close - disconnect - error - timeout - binary { close $socket }
        }
    }]} { close $socket }
}

proc auxiliary::backend {channel type message} {
    variable backends
    if {![info exists backends($channel)]} { return }
    set socket $backends($channel)
    if {[catch {
        switch -- $type {
            text {
                ::huddle::json2huddle $message
                if {[websocket::send $socket text $message] < 0} { close $socket }
            }
            close - disconnect - error - timeout - binary { close $socket }
        }
    }]} { close $socket }
}

proc auxiliary::ready {channel ready} {
    variable backends; variable keys
    if {![info exists backends($channel)]} { return }
    set socket $backends($channel)
    if {!$ready || [catch {
        websocket::takeover $channel auxiliary::backend 0
        upgrade_client $socket $keys($socket) auxiliary::event
        unset keys($socket)
    }]} { close $socket }
}

proc auxiliary::open {socket key} {
    variable clients; variable backends; variable keys
    if {[catch {
        # The endpoint credential belongs to the native TUI, not the tunnel.
        set credential $::env(CODEX_RETRY_TOKEN)
        unset ::env(CODEX_RETRY_TOKEN)
        try {
            set channel [terminal::pipe [concat [list | codex app-server proxy] $::backendOptions \
                [list 2>@$::diagnostics::writer]] r+]
        } finally { set ::env(CODEX_RETRY_TOKEN) $credential }
        set clients($socket) $channel
        set backends($channel) $socket
        set keys($socket) $key
        backend_upgrade $channel auxiliary::ready
    }]} {
        if {[info exists clients($socket)]} { close $socket } else { catch {::close $socket} }
    }
}

proc upgrade_client {socket key handler} {
    puts $socket "HTTP/1.1 101 Switching Protocols\nUpgrade: websocket\nConnection: Upgrade\nSec-WebSocket-Accept: $key\n"
    flush $socket
    websocket::takeover $socket $handler 1
}

proc accept {socket address port} {
    fconfigure $socket -blocking 0 -buffering line -encoding ascii -translation crlf
    set ::handshakes($socket) [dict create lines {} size 0 \
        timer [after 10000 [list drop_handshake $socket]]]
    fileevent $socket readable [list handshake $socket]
}

proc drop_handshake {socket} {
    if {[info exists ::handshakes($socket)]} {
        after cancel [dict get $::handshakes($socket) timer]
        unset ::handshakes($socket)
    }
    catch {close $socket}
}

proc handshake {socket} {
    while {1} {
        if {[catch {gets $socket line} count]} { drop_handshake $socket; return }
        if {$count < 0} { break }
        dict lappend ::handshakes($socket) lines $line
        dict incr ::handshakes($socket) size [expr {[string length $line] + 2}]
        set lines [dict get $::handshakes($socket) lines]
        if {[llength $lines] > 64 || [dict get $::handshakes($socket) size] > 16384} {
            drop_handshake $socket
            return
        }
        if {$line eq ""} {
            fileevent $socket readable ""
            set request [lindex $lines 0]
            set headers {}
            foreach line [lrange $lines 1 end-1] {
                if {![regexp {^([^:[:space:]]+):[ \t]*(.*)$} $line -> key value]} {
                    drop_handshake $socket
                    return
                }
                set key [string tolower $key]
                set value [string trim $value]
                if {[dict exists $headers $key]} {
                    # Tcllib sends repeated Connection fields; credentials stay unique.
                    if {$key ne "connection"} { drop_handshake $socket; return }
                    dict append headers $key ", $value"
                } else { dict set headers $key $value }
            }
            if {$request eq "GET / HTTP/1.1" && \
                ![dict exists $headers origin] && \
                [field $headers authorization] eq "Bearer $::env(CODEX_RETRY_TOKEN)" && \
                [string tolower [field $headers upgrade]] eq "websocket" && \
                ![catch {websocket::validate $headers} upgrade]} {
                set key [websocket::sec-websocket-accept [dict get $upgrade key]]
                after cancel [dict get $::handshakes($socket) timer]
                unset ::handshakes($socket)
                if {[info exists ::client]} {
                    auxiliary::open $socket $key
                } elseif {[catch {upgrade_client $socket $key connection}]} {
                    catch {close $socket}
                }
            } else { drop_handshake $socket }
            return
        }
    }
    if {[eof $socket] || [dict get $::handshakes($socket) size] + \
        [chan pending input $socket] > 16384} { drop_handshake $socket }
}

namespace eval diagnostics {
    variable channel ""
    variable writer ""
    variable tail ""
    variable truncated 0
}

# Binary reads retain at most 64 KiB, with at most 16 KiB of work per callback.
proc diagnostics::retain {data} {
    variable tail; variable truncated
    append tail $data
    if {[string length $tail] > 65536} {
        set tail [string range $tail end-65535 end]
        set truncated 1
    }
}

proc diagnostics::drain {} {
    variable channel; variable truncated
    if {$channel eq ""} { return }
    for {set i 0} {$i < 4} {incr i} {
        if {[catch {read $channel 4096} data]} {
            set truncated 1
        } else {
            retain $data
            if {![eof $channel]} {
                if {$data eq ""} { return }
                continue
            }
        }
        catch {close $channel}
        set channel ""
        return
    }
}

proc diagnostics::finish {} {
    variable channel; variable writer
    catch {close $writer}
    set writer ""
    # The backend has been reaped. Bound the final drain even if a descendant
    # inherited stderr; reading more than the retained tail also marks truncation.
    for {set i 0} {$i < 5} {incr i} { drain }
    catch {close $channel}
    set channel ""
}

proc diagnostics::report {} {
    variable tail; variable truncated
    if {$tail eq "" && !$truncated} { return }
    catch {
        puts stderr "codex-retry: background app-server diagnostics (shown after terminal release):"
        if {$truncated} { puts stderr "codex-retry: output truncated; showing up to 64 KiB of retained diagnostics." }
        puts stderr [encoding convertfrom utf-8 $tail]
        flush stderr
    }
    set tail ""
    set truncated 0
}

proc terminate {children} {
    if {![llength $children]} { return }
    catch {exec kill -TERM {*}$children}
    # Bound graceful shutdown, then reap even a child that ignores SIGTERM.
    for {set i 0} {$i < 20 && [llength $children]} {incr i} {
        diagnostics::drain
        set alive {}
        foreach child $children {
            if {![catch {exec kill -0 $child}]} { lappend alive $child }
        }
        set children $alive
        if {[llength $children]} { after 25 }
    }
    if {[llength $children]} { catch {exec kill -KILL {*}$children} }
}

proc cleanup {} {
    automatic::cancel
    set ::automatic::live {}
    retry::reset
    resume::reset
    catch {close $::listener}
    unset -nocomplain ::listener
    foreach socket [array names ::handshakes] { drop_handshake $socket }
    foreach socket [array names ::auxiliary::clients] { auxiliary::close $socket }
    catch {close $::client}
    unset -nocomplain ::client
    if {[info exists ::backend]} {
        set channel $::backend
        unset ::backend
        close_backend $channel
    }
    diagnostics::finish
}

proc close_backend {channel} {
    if {[info exists ::upgrades($channel)]} {
        after cancel [dict get $::upgrades($channel) timer]
        unset ::upgrades($channel)
    }
    set children [pid $channel]
    fileevent $channel readable ""
    catch {websocket::configure $channel -keepalive 0}
    terminate $children
    fconfigure $channel -blocking 1
    catch {websocket::close $channel}
    catch {close $channel}
}

# Restore the outer terminal even when the child could not run its exit code.
# Mouse modes live in the emulator, independently of the saved termios state.
namespace eval terminal { variable saved "" }
proc terminal::restore {} {
    variable saved
    if {$saved eq ""} { return }
    if {[catch {exec stty $saved <@stdin}]} { catch {exec stty $saved < /dev/tty} }
    catch {
        puts -nonewline stdout "\033\[?1000l\033\[?1002l\033\[?1003l\033\[?1005l\033\[?1006l\033\[?1015l"
        flush stdout
    }
    set saved ""
}

# Treat SIGINT like a native Ctrl+C once the TUI can receive input.
proc terminal::interrupt {} {
    if {[info exists ::tuiSpawn]} {
        # An already exiting TUI may have closed its PTY; keep its exit status.
        catch {send -i $::tuiSpawn -- "\003"}
        return
    }
    shutdown 130
}

# Owned pipe children must survive a terminal's foreground-group SIGINT.
proc terminal::pipe {command mode} {
    open [linsert $command 1 sh -c {trap '' INT; exec "$@"} codex-retry] $mode
}

proc shutdown {status} {
    set ::signalStatus $status
    cleanup
    if {[info exists ::tuiPid]} {
        terminate [list $::tuiPid]
    } else {
        terminal::restore
        diagnostics::report
        exit $status
    }
}

# Only the short-lived starter and the stdio bridges are wrapper children.
# Codex owns socket selection and the daemon, including after a cold start.
proc backend_upgrade {channel callback {timeout 10000}} {
    # Proxy is a byte tunnel to a WebSocket control socket, not JSONL stdio.
    # Bootstrap HTTP here; Tcllib owns all subsequent framing and UTF-8.
    set random [open /dev/urandom rb]
    set key [binary encode base64 -maxlen 0 [read $random 16]]
    close $random
    set ::upgrades($channel) [dict create accept [websocket::sec-websocket-accept $key] \
        headers {} size 0 callback $callback \
        timer [after $timeout [list backend_upgraded $channel 0]]]
    fconfigure $channel -blocking 0 -buffering none -encoding ascii -translation crlf
    puts $channel "GET / HTTP/1.1\nHost: localhost\nUpgrade: websocket\nConnection: Upgrade\nSec-WebSocket-Version: 13\nSec-WebSocket-Key: $key\n"
    fileevent $channel readable [list backend_upgrade_read $channel]
}

proc backend_upgrade_read {channel} {
    if {![info exists ::upgrades($channel)]} { return }
    set ready 0
    if {[catch {
        while {[gets $channel line] >= 0} {
            dict incr ::upgrades($channel) size [expr {[string length $line] + 2}]
            if {[dict get $::upgrades($channel) size] > 16384} { error "oversized upgrade" }
            if {$line eq ""} {
                set lines [dict get $::upgrades($channel) headers]
                if {![regexp {^HTTP/1\.1 101(?:[ \t].*)?$} [lindex $lines 0]]} { error "upgrade rejected" }
                set headers {}
                foreach line [lrange $lines 1 end] {
                    if {![regexp {^([^:[:space:]]+):[ \t]*(.*)$} $line -> name value]} { error "invalid header" }
                    set name [string tolower $name]
                    if {[dict exists $headers $name]} { error "duplicate header" }
                    dict set headers $name [string trim $value]
                }
                if {[string tolower [field $headers upgrade]] ne "websocket" || \
                    ![regexp -nocase {(^|,)\s*upgrade\s*(,|$)} [field $headers connection]] || \
                    [field $headers sec-websocket-accept] ne [dict get $::upgrades($channel) accept]} { error "invalid upgrade" }
                set ready 1
                break
            }
            dict lappend ::upgrades($channel) headers $line
            if {[llength [dict get $::upgrades($channel) headers]] > 64} { error "oversized upgrade" }
        }
        if {[eof $channel] || [dict get $::upgrades($channel) size] + \
            [chan pending input $channel] > 16384} { error "incomplete upgrade" }
    }]} { backend_upgraded $channel 0; return }
    if {$ready} { backend_upgraded $channel 1 }
}

proc backend_upgraded {channel ready} {
    if {![info exists ::upgrades($channel)]} { return }
    set state $::upgrades($channel)
    unset ::upgrades($channel)
    after cancel [dict get $state timer]
    fileevent $channel readable ""
    if {$ready} { fconfigure $channel -encoding binary -translation binary }
    {*}[dict get $state callback] $channel $ready
}

proc backend_attach {{timeout 10000}} {
    set ::backendReady 0
    backend_upgrade $::backend {apply {{channel ready} {set ::backendReady [expr {$ready ? 1 : -1}]}}} $timeout
    vwait ::backendReady
    if {$::backendReady != 1} { error "shared app-server WebSocket attachment failed or timed out" }
    websocket::takeover $::backend backend_event 0
}

proc start_backend {options} {
    set ::backend [terminal::pipe [concat [list | codex app-server daemon start] $options \
        [list 2>@$::diagnostics::writer]] r]
    fconfigure $::backend -blocking 0 -encoding binary -translation binary
    set ::backendReady 0
    fileevent $::backend readable {
        set data [read $::backend 4096]
        diagnostics::retain $data
        if {[eof $::backend]} {
            fileevent $::backend readable ""
            set ::backendReady 1
        }
    }
    set deadline [after 10000 {set ::backendReady -1}]
    vwait ::backendReady
    after cancel $deadline
    if {$::backendReady != 1} { error "shared app-server startup timed out" }
    set channel $::backend
    unset ::backend
    fconfigure $channel -blocking 1
    if {[catch {close $channel} message]} { error "shared app-server startup failed: $message" }
    set ::backend [terminal::pipe [concat [list | codex app-server proxy] $options \
        [list 2>@$::diagnostics::writer]] r+]
    backend_attach
}

proc bgerror {message} {
    set ::proxyError 1
    if {![info exists ::proxyMessage]} { set ::proxyMessage $message }
    cleanup
    if {[info exists ::tuiPid]} { terminate [list $::tuiPid] }
}

proc resize {} {
    catch {
        lassign [exec stty size <@stdin] rows columns
        stty rows $rows columns $columns < $::spawn_out(slave,name)
    }
}

# The interactive options that take one value. Attached values need no skipping.
proc detached_value {argument} {
    return [expr {$argument in {
        -c --config --enable --disable -m --model --local-provider -p --profile
        -s --sandbox -a --ask-for-approval -C --cd --add-dir -i --image
        --remote --remote-auth-token-env
    }}]
}

proc resume_arguments {arguments} {
    set command ""
    set flags {}
    set conflicts {}
    for {set i 0} {$i < [llength $arguments]} {incr i} {
        set argument [lindex $arguments $i]
        if {$argument eq "--"} { break }
        if {$argument in {--yolo --dangerously-bypass-approvals-and-sandbox}} {
            lappend flags $i
        }
        # 0.162.1 conflicts: explicit approval policy and automatic review aliases.
        if {$argument in {--approve-for-me --not-so-yolo -a --ask-for-approval} || \
            [regexp {^--ask-for-approval=|^-a.+} $argument]} { lappend conflicts $argument }
        if {[detached_value $argument]} { incr i; continue }
        if {$command eq "" && ![string match -* $argument]} { set command $argument }
    }
    set ::recovery::yolo [expr {[llength $flags] > 0}]
    if {$command ne "resume" || ![llength $flags]} { return [list $arguments 0] }
    if {[llength $conflicts]} { error "resume --yolo conflicts with [join $conflicts {, }]" }
    foreach index [lreverse $flags] { set arguments [lreplace $arguments $index $index] }
    return [list $arguments 1]
}

proc backend_options {arguments} {
    # Share config overrides with app-server; the TUI keeps all other arguments.
    set options {}
    for {set i 0} {$i < [llength $arguments]} {incr i} {
        set argument [lindex $arguments $i]
        if {$argument eq "--"} { break }
        if {$argument in {--remote --remote-auth-token-env} || \
            [regexp {^--remote(?:-auth-token-env)?=} $argument]} {
            error "remote connection options are owned by codex-retry"
        }
        if {$argument in {-c --config --enable --disable}} {
            if {$i + 1 == [llength $arguments]} { error "missing value for $argument" }
            set value [lindex $arguments [incr i]]
            if {[regexp {^[|<>]} $value] || [regexp {^2[<>]} $value]} {
                error "invalid value for $argument"
            }
            lappend options $argument $value
        } elseif {[regexp {^--(config|enable|disable)=|^-c.+} $argument]} {
            lappend options $argument
        } elseif {[detached_value $argument]} {
            incr i
        }
    }
    return $options
}

proc main {arguments} {
    global spawn_out tuiSpawn
    automatic::configure
    package require websocket
    # Tcllib's default logger writes to stdout. Retain fixed transport labels,
    # without protocol payloads, until the TUI has released the terminal.
    foreach level [logger::levels] {
        ${::websocket::log}::logproc $level message \
            [list ::diagnostics::retain "WebSocket $level diagnostic\n"]
    }
    set options [backend_options $arguments]
    set ::backendOptions $options
    if {[catch {set ::terminal::saved [exec stty -g <@stdin]}]} {
        catch {set ::terminal::saved [exec stty -g < /dev/tty]}
    }
    lassign [resume_arguments $arguments] arguments yolo
    resume::reset
    set ::resume::armed $yolo
    set random [open /dev/urandom rb]
    set token [binary encode hex [read $random 16]]
    set retry::prefix "codex-retry-[binary encode hex [read $random 16]]"
    close $random
    set ::listener [socket -server accept -myaddr 127.0.0.1 0]
    set port [lindex [fconfigure $::listener -sockname] 2]
    set ::presentation::endpoint ws://127.0.0.1:$port/
    # A parent can close our PTY after EOF while Tcl is still finalizing.
    exit -onexit {trap SIG_IGN {SIGHUP SIGWINCH}}
    trap {shutdown 143} SIGTERM
    trap {shutdown 129} SIGHUP
    trap terminal::interrupt SIGINT
    lassign [chan pipe] ::diagnostics::channel ::diagnostics::writer
    fconfigure $::diagnostics::channel -blocking 0 -encoding binary -translation binary
    fileevent $::diagnostics::channel readable diagnostics::drain
    start_backend $options
    # Only the TUI needs the proxy credential.
    set ::env(CODEX_RETRY_TOKEN) $token
    spawn -noecho codex --remote $::presentation::endpoint \
        --remote-auth-token-env CODEX_RETRY_TOKEN {*}$arguments
    set tuiSpawn $spawn_id
    set ::tuiPid [exp_pid]
    if {[info exists ::proxyError]} { error $::proxyMessage }
    # EOF can precede exit; keep the PTY open so close cannot hang up the TUI.
    close_on_eof -i $tuiSpawn 0
    # User input can end while stdout must still receive the TUI's final bytes.
    close_on_eof -i $::user_spawn_id 0
    # The adapter handles bytes, including split UTF-8 and terminal sequences.
    fconfigure $tuiSpawn -encoding binary -translation binary
    fconfigure stdin -encoding binary -translation binary
    fconfigure stdout -encoding binary -translation binary
    fconfigure $::user_spawn_id -encoding binary -translation binary
    remove_nulls -i $tuiSpawn 0
    resize
    trap resize SIGWINCH
    # Expect resolves indirect spawn-ID variables in the global scope.
    set ::terminal::input $::user_spawn_id
    set killTimer ""
    try {
        interact -input ::terminal::input eof {
            set ::terminal::input {}
            cleanup
            catch {exec kill -TERM $::tuiPid}
            # Keep draining the PTY during graceful exit and after forced exit.
            set killTimer [after 500 [list catch [list exec kill -KILL $::tuiPid]]]
        } -output $tuiSpawn -input $tuiSpawn -re {[^\x00]+} {
            presentation::feed $interact_out(0,string)
        } null { presentation::feed "\x00" } -output $::user_spawn_id
    } finally {
        after cancel $killTimer
    }
    trap SIG_IGN SIGWINCH
    set result [wait -i $tuiSpawn]
    close -i $tuiSpawn
    unset ::tuiPid tuiSpawn
    cleanup
    terminal::restore
    presentation::finish
    diagnostics::report
    if {[info exists ::proxyMessage]} { catch {puts stderr "codex-retry: $::proxyMessage"} }
    # Optional guidance must preserve the TUI's exit status even if stderr fails.
    catch {
        puts stderr "codex-retry: client disconnected; shared server and background work may continue."
        if {!$::presentation::replaced} { puts -nonewline stderr [recovery::advice] }
    }
    if {[info exists ::signalStatus]} { return $::signalStatus }
    if {[info exists ::proxyError]} { return 1 }
    if {[lindex $result 2] != 0} { error "failed to wait for Codex: $result" }
    if {[lindex $result 4] eq "CHILDKILLED"} {
        return [expr {128 + [exec kill -l [lindex $result 5]]}]
    }
    return [lindex $result 3]
}

if {[file normalize [info script]] eq [file normalize $argv0]} {
    if {[catch {main $argv} result]} {
        if {[info exists ::tuiPid]} { terminate [list $::tuiPid] }
        catch {wait -i $::tuiSpawn}
        catch {close -i $::tuiSpawn}
        unset -nocomplain ::tuiPid ::tuiSpawn
        cleanup
        terminal::restore
        catch {presentation::finish}
        diagnostics::report
        catch {puts stderr "codex-retry: $result"}
        if {[info exists ::signalStatus]} { exit $::signalStatus }
        exit 1
    }
    exit $result
}
